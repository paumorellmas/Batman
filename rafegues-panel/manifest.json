{
  "manifestVersion": 5,
  "id": "cat.reportatge.rafegues",
  "name": "Ràfegues",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "rafeguesPanel",
      "label": { "default": "Ràfegues" },
      "minimumSize": { "width": 220, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 440 },
      "preferredFloatingSize": { "width": 300, "height": 440 }
    }
  ]
}
